<div class="d-flex flex-column justify-content-center align-items-center px-2">

    <div class="bt-page-title">
        <a asp-controller="Home" asp-action="Index" class="btn text-white">
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-arrow-left-circle-fill bt-icon" viewBox="0 0 16 16">
                <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z" />
            </svg>
        </a>
        <h1>Recuperacion de contraseña</h1>
    </div>

    <div class="border rounded box-shadow p-4 bg-secondary bt-auth-panel">
        <form id="forgotPasswordForm" asp-action="ForgotPassword" asp-controller="Home" method="post" class="d-flex flex-column align-items-stretch justify-content-center">
            <div class="mb-3 w-100">
                <label class="form-label" for="email">Email:</label>
                <input type="email" id="email" name="email" placeholder="Ingresa tu email" class="form-control" />
            </div>

            <button type="button" class="btn btn-primary mt-2 align-self-center" onclick="forgotPassword()">Recuperar contraseña</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/Home/ForgotPassword.js" asp-append-version="true"></script>
}
