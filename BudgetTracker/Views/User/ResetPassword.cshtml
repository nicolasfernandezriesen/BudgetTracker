@model BudgetTracker.ViewModels.User.ResetPasswordViewModel;

<div class="d-flex flex-column justify-content-center align-items-center my-3 my-md-5 px-2">
    <div class="bt-page-title">
        <a asp-controller="Home" asp-action="Index" class="btn text-white">
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-arrow-left-circle-fill bt-icon" viewBox="0 0 16 16">
                <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z" />
            </svg>
        </a>
        <h1>Cambio de contraseña</h1>
    </div>

    <div class="border rounded box-shadow p-4 bg-secondary bt-auth-panel">
        <form id="resetPasswordForm" asp-action="ResetPassword" asp-controller="User" method="post" class="d-flex flex-column justify-content-center align-items-stretch">
            @Html.AntiForgeryToken()
            <div class="mb-2 w-100">
                <label class="form-label" asp-for="NewPassword">Nueva contraseña:</label>
                <input type="password" id="newPassword" asp-for="NewPassword" placeholder="Ingresa tu nueva contraseña" class="form-control" />
            </div>

            <div class="mb-2 w-100">
                <label class="form-label" asp-for="ConfirmPassword">Confirmar contraseña:</label>
                <input type="password" id="confirmPassword" asp-for="ConfirmPassword" placeholder="Confirma tu nueva contraseña" class="form-control" />
            </div>

            <div class="mt-2 align-self-center">
                <button type="button" class="btn btn-primary" onclick="ResetPassword()">Cambiar contraseña</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const _CONFIG_RESET = {
            email: "@Model.Email",
            token: "@Model.Token"
        };
    </script>

    <script src="~/js/User/ResetPassword.js" asp-append-version="true"></script>
}
