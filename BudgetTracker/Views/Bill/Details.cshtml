@model BudgetTracker.ViewModels.DetailBillIncomeViewModel

@if (Model.Bill != null)
{
<div class="d-flex flex-column justify-content-center align-items-center px-2">

    <div class="bt-page-title">
        <button onclick="goBackPage('@Model.Date.ToString("dd/MM/yyyy")')" class="btn text-white">
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-arrow-left-circle-fill bt-icon" viewBox="0 0 16 16">
                <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z" />
            </svg>
        </button>
        <h1>Detalles de los gastos del dia @Model.Date.ToString("dd/MM/yyyy")</h1>
    </div>
    <div class="d-flex flex-row justify-content-center align-items-center w-100">
        <div class="border rounded box-shadow p-3 p-md-4 m-2 m-md-4 bg-secondary center bt-panel-wide">
            <div class="bt-table-scroll">
            <table class="table table-bordered text-center">
                <thead>
                    <tr>
                        <th>Categoria</th>
                        <th>Gasto</th>
                        <th>Descripcion</th>
                        <th>Menu</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bill in Model.Bill)
                    {
                        <tr>
                            <td>@bill.Category.CategoryName</td>
                            <td>@bill.BillsAmount.ToString("C", new System.Globalization.CultureInfo("es-AR"))</td>
                            <td>@(bill.BillsDesc ?? "No hay descripcion alguna del gasto.")</td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-secondary" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu bg-secondary" aria-labelledby="dropdownMenuButton">
                                        <li>
                                            <form asp-action="Edit" asp-controller="Bill" method="get">
                                                <input type="hidden" name="id" value="@bill.BillsId" />
                                                <input type="hidden" name="selectedDate" value="@Model.Date.ToString()" />
                                                <button type="submit" class="dropdown-item">Editar</button>
                                            </form>
                                        </li>
                                        <li>
                                            <form asp-action="Delete" asp-controller="Bill" method="post" id="deleteFromr_@bill.BillsId">
                                                <input type="hidden" name="id" value="@bill.BillsId" />
                                                <input type="hidden" name="selectedDate" value="@Model.Date.ToString()" />
                                                <button type="button" class="dropdown-item" onclick="Delete('bill', '@bill.BillsId')">Borrar</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr>
                        <td></td>
                        <td></td>
                        <td>
                            <form asp-action="Create" asp-controller="Bill" method="get">
                                <input type="hidden" name="selectedDate" value="@Model.Date.ToString()" />
                                <button type="submit" class="btn btn-secondary">Agregar nuevo gasto</button>
                            </form>
                        </td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/History/History.js" asp-append-version="true"></script>
}
}
else
{
    <p>UPPPSSSS...TRY AGAIN.</p>
}
